<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <!-- App Branding -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flow"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Habits"
                android:textColor="#8E94A6"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Progress Badge -->
        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_progress_badge"
            android:text="0/0 done"
            android:textColor="#E8845C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp" />
    </RelativeLayout>

    <!-- Row 0 -->
    <LinearLayout
        android:id="@+id/habit_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- Checkbox icon -->
        <ImageView
            android:id="@+id/habit_checkbox_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_checkbox_unchecked" />

        <!-- Loading spinner (shown while API call in progress) -->
        <ProgressBar
            android:id="@+id/habit_loading_0"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="#E8845C"
            android:visibility="gone" />

        <TextView
            android:id="@+id/habit_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#E3E5EB"
            android:textSize="15sp"
            android:text="Habit 1" />

        <TextView
            android:id="@+id/habit_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_time_badge"
            android:textColor="#A0A5B5"
            android:textSize="11sp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="08:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/habit_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/habit_checkbox_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_checkbox_unchecked" />

        <ProgressBar
            android:id="@+id/habit_loading_1"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="#E8845C"
            android:visibility="gone" />

        <TextView
            android:id="@+id/habit_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#E3E5EB"
            android:textSize="15sp"
            android:text="Habit 2" />

        <TextView
            android:id="@+id/habit_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_time_badge"
            android:textColor="#A0A5B5"
            android:textSize="11sp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="12:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/habit_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/habit_checkbox_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_checkbox_unchecked" />

        <ProgressBar
            android:id="@+id/habit_loading_2"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="#E8845C"
            android:visibility="gone" />

        <TextView
            android:id="@+id/habit_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#E3E5EB"
            android:textSize="15sp"
            android:text="Habit 3" />

        <TextView
            android:id="@+id/habit_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_time_badge"
            android:textColor="#A0A5B5"
            android:textSize="11sp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="18:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/habit_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/habit_checkbox_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_checkbox_unchecked" />

        <ProgressBar
            android:id="@+id/habit_loading_3"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="#E8845C"
            android:visibility="gone" />

        <TextView
            android:id="@+id/habit_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#E3E5EB"
            android:textSize="15sp"
            android:text="Habit 4" />

        <TextView
            android:id="@+id/habit_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_time_badge"
            android:textColor="#A0A5B5"
            android:textSize="11sp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="21:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="All done for today!"
        android:textColor="#8E94A6"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Auth State -->
    <TextView
        android:id="@+id/widget_auth_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="Please log in to see your habits"
        android:textColor="#8E94A6"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
